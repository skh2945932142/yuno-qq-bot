{
  "name": "yuno-qq-bot",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node run-phase1-tests.js",
    "test:coverage": "c8 --all --src src --reporter=text --reporter=html --reporter=json-summary node run-phase1-tests.js",
    "test:coverage:ci": "node scripts/check-coverage.js",
    "eval": "node evals/run-evals.js",
    "eval:report": "node evals/run-evals.js --report reports/eval-experience.md",
    "eval:style": "node evals/run-style-evals.js",
    "eval:style:report": "node evals/run-style-evals.js --report reports/eval-reply-style.md",
    "eval:style:model": "node evals/run-style-model-evals.js --report reports/eval-reply-style-model.md",
    "kb:sync": "node scripts/kb-sync.js",
    "retrieval:backfill": "node scripts/retrieval-backfill.js",
    "meme:import": "node scripts/meme-import.js",
    "doctor": "node doctor.js",
    "smoke": "node smoke.js",
    "smoke:mock": "node scripts/smoke-mock.js",
    "benchmark:reply": "node scripts/benchmark-reply-latency.js",
    "security:audit": "node scripts/security-audit.js",
    "security:secrets": "node scripts/security-secrets.js",
    "automation:ideas": "node scripts/experience-ideas.js",
    "automation:dev-health": "node scripts/dev-health-report.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@koishijs/plugin-auth": "4.1.7",
    "@koishijs/plugin-config": "2.8.6",
    "@koishijs/plugin-console": "5.30.11",
    "@koishijs/plugin-database-mongo": "5.7.0",
    "@koishijs/plugin-http": "0.6.3",
    "@koishijs/plugin-server": "3.2.9",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "axios": "1.18.1",
    "bullmq": "^5.56.1",
    "dotenv": "^17.3.1",
    "ioredis": "^5.8.1",
    "koishi": "4.18.11",
    "koishi-plugin-adapter-onebot": "6.9.4",
    "mongoose": "9.8.0",
    "node-cron": "^4.2.1",
    "openai": "^6.27.0",
    "semver": "7.7.4",
    "silk-sdk": "^0.2.2",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "c8": "12.0.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
