# Copy to .env when running the unified Koishi + Yuno application on a server.
NODE_ENV=production
YUNO_PLUGIN_MODE=active

# Koishi is the only OneBot client and QQ message sender.
SELF_QQ=replace-with-your-bot-qq
ADMIN_QQ=replace-with-your-admin-qq
ONEBOT_TRANSPORT=ws
ONEBOT_ENDPOINT=ws://127.0.0.1:3000
ONEBOT_TOKEN=replace-with-your-onebot-token
KOISHI_PORT=5140
KOISHI_MONGODB_URI=mongodb://127.0.0.1:27017/koishi
KOISHI_CONSOLE_ENABLED=false
# Only configure these when the Console is enabled behind private access.
KOISHI_CONSOLE_ADMIN=
KOISHI_CONSOLE_PASSWORD=

# Yuno domain data uses an independent database in the same MongoDB service.
MONGODB_URI=mongodb://127.0.0.1:27017/yuno
MONGO_MAX_POOL_SIZE=10
METRICS_AUTH_TOKEN=replace-with-a-long-metrics-token
METRICS_PATH=/metrics

# LLM and final reply providers.
OPENAI_API_KEY=replace-with-your-llm-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_CHAT_MODEL=gpt-4o-mini
REPLY_LLM_API_KEY=replace-with-your-reply-llm-api-key
REPLY_LLM_BASE_URL=https://api.openai.com/v1
REPLY_LLM_CHAT_MODEL=gpt-4o-mini
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Optional services. Qdrant and voice degrade readiness without blocking text chat.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=qq_bot_knowledge
QDRANT_API_KEY=
ENABLE_VOICE=false
FFMPEG_PATH=/usr/bin/ffmpeg
TTS_API_KEY=
TTS_BASE_URL=
TTS_PROVIDER=openai_compatible
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=

# Queue workers always run in this process. Redis is optional.
ENABLE_QUEUE=false
REDIS_URL=redis://127.0.0.1:6379
QUEUE_CONNECT_TIMEOUT_MS=3000

# Yuno behavior and local meme cache.
TARGET_GROUP_ID=
REPLY_SEGMENTATION_ENABLED=true
REPLY_SEGMENT_MAX_COUNT=3
REPLY_SEGMENT_MIN_DELAY_MS=600
REPLY_SEGMENT_MAX_DELAY_MS=1400
PRIVATE_MESSAGE_AGGREGATION_ENABLED=true
PRIVATE_MESSAGE_AGGREGATION_WINDOW_MS=1200
PRIVATE_MESSAGE_AGGREGATION_MAX_WINDOW_MS=5000
GROUP_REPLY_QUOTE_ENABLED=true
GROUP_REPLY_QUOTE_MODE=auto
REPLY_SEGMENT_TRIM_TRAILING_PERIOD=true
GROUP_MESSAGE_AGGREGATION_ENABLED=true
GROUP_MESSAGE_AGGREGATION_WINDOW_MS=900
GROUP_MESSAGE_AGGREGATION_MAX_WINDOW_MS=3000
REPLY_CADENCE_ENABLED=true
REPLY_CADENCE_READ_MS_PER_CHAR=12
REPLY_CADENCE_READ_MAX_MS=1200
REPLY_CADENCE_MIN_PRE_DELAY_MS=350
REPLY_CADENCE_MAX_PRE_DELAY_MS=1800
REPLY_CADENCE_TYPING_MS_PER_CHAR=70
REPLY_CADENCE_TYPING_MAX_MS=2600
REPLY_CADENCE_JITTER_RATIO=0.25
TYPING_INDICATOR_ENABLED=true
PARTICIPATION_SKIP_PROBABILITY=0.12
PARTICIPATION_REACTION_PROBABILITY=0.18
PARTICIPATION_MAX_CONSECUTIVE_REPLIES=2
AMBIENT_JOIN_ENABLED=true
AMBIENT_JOIN_PROBABILITY=0.02
AMBIENT_JOIN_COOLDOWN_MS=600000
AMBIENT_JOIN_MAX_PER_DAY=6
MEMORY_EXTRACTION_ENABLED=true
MEME_ENABLED=true
MEME_AUTO_COLLECT=true
MEME_AUTO_SEND=false
MEME_PROVIDER=local-cache
