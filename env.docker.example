# Copy to .env when running the unified Koishi + Yuno application in Docker.
NODE_ENV=production
YUNO_PLUGIN_MODE=active

# Koishi is the only OneBot client and QQ message sender.
SELF_QQ=replace-with-your-bot-qq
ADMIN_QQ=replace-with-your-admin-qq
ONEBOT_ENDPOINT=http://napcat:3000
ONEBOT_TOKEN=replace-with-your-onebot-token
ONEBOT_SECRET=replace-with-your-onebot-event-secret
KOISHI_PORT=8080
KOISHI_MONGODB_URI=mongodb://mongo:27017/koishi
KOISHI_CONSOLE_ENABLED=false
# Only configure these when the Console is enabled behind private access.
KOISHI_CONSOLE_ADMIN=
KOISHI_CONSOLE_PASSWORD=

# Yuno domain data uses an independent database in the same MongoDB service.
MONGODB_URI=mongodb://mongo:27017/yuno
MONGO_MAX_POOL_SIZE=10
METRICS_AUTH_TOKEN=replace-with-a-long-metrics-token
METRICS_PATH=/metrics

# LLM and final reply providers.
OPENAI_API_KEY=replace-with-your-llm-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_CHAT_MODEL=gpt-4o-mini
REPLY_LLM_API_KEY=replace-with-your-reply-llm-api-key
REPLY_LLM_BASE_URL=https://api.openai.com/v1
REPLY_LLM_CHAT_MODEL=gpt-4o-mini
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Optional services. Qdrant and voice degrade readiness without blocking text chat.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=qq_bot_knowledge
QDRANT_API_KEY=
ENABLE_VOICE=false
FFMPEG_PATH=/usr/bin/ffmpeg
TTS_API_KEY=
TTS_BASE_URL=
TTS_PROVIDER=openai_compatible
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=

# Queue workers always run in this process. Redis is optional.
ENABLE_QUEUE=false
REDIS_URL=redis://redis:6379
QUEUE_CONNECT_TIMEOUT_MS=3000

# Yuno behavior and QQ favorite meme synchronization.
TARGET_GROUP_ID=
MEMORY_EXTRACTION_ENABLED=true
MEME_ENABLED=true
MEME_AUTO_COLLECT=true
MEME_AUTO_SEND=false
MEME_PROVIDER=onebot-favorites
MEME_FAVORITES_COUNT=48
MEME_FAVORITES_SYNC_TTL_MS=3600000
