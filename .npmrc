# silk-sdk compiles through node-gyp, which fetches Node headers over the network.
# A single ETIMEDOUT on that fetch failed the 2026-08-13 Zeabur build (deployment
# 6a7d67cd), so give npm's own fetches room to recover instead of dying on attempt 1.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# node-gyp reads this and skips the header download entirely when the directory has
# them bundled, which is the case in every official node image (/usr/local/include/node).
# It is only honoured when set, so it lives in the Dockerfile and in the Zeabur build
# environment rather than here: hardcoding a POSIX path would break `npm ci` on Windows.
